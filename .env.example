# Copier ce fichier en ".env.local" (non versionné) et remplir avec les valeurs
# de ton projet Supabase : Project Settings > API Keys.
# Utilise la clé PUBLISHABLE (sb_publishable_...). Elle est publique par conception :
# la sécurité repose sur les règles RLS et les fonctions SQL de supabase/migrations.
# Ne mets JAMAIS la clé secret (sb_secret_...) ici.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Lien de la page produit Chariow (affiché sur l'écran d'activation)
VITE_CHARIOW_URL=https://REMPLACER-PAR-LE-LIEN-DE-TA-PAGE-PRODUIT

# Notifications : clé PUBLIQUE VAPID (la clé privée va uniquement dans les secrets de la fonction Supabase).
VITE_VAPID_PUBLIC_KEY=
